<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Accessible Public Services Portal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
  <!-- Skip link: first focusable element, visible on focus only -->
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header>
    <nav class="navbar navbar-expand-lg portal-nav" aria-label="Main navigation">
      <div class="container">
        <a class="navbar-brand" href="/">Public Services Portal</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#mainNav" aria-controls="mainNav"
                aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" href="/Services">Services</a></li>
            <li class="nav-item"><a class="nav-link" href="/Services/New">Submit a request</a></li>
            <li class="nav-item"><a class="nav-link" href="/Services/Track">Track a request</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </header>
  <main id="main-content" class="container py-4" tabindex="-1">
    @if (TempData["Success"] is string success)
    {
      <!-- aria-live so screen readers announce the confirmation -->
      <div class="alert alert-success" role="alert" aria-live="polite">@success</div>
    }
    @RenderBody()
  </main>
  <footer class="container py-4">
    <p>Sample portal. Fictional services, no real citizen data.</p>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/accessibility.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
